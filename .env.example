# Server-only Supabase connection. Never prefix the service key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional legacy owner bootstrap endpoint. Current first-owner setup uses a single-use database invitation.
BRANDON_RV_SETUP_SECRET=

# Central OrbitFS Mail delivery. Create a send-only external-system key in Mail Admin.
ORBITFS_MAIL_URL=
BRANDONSRV_MAIL_API_KEY=

# Required for encrypted server-side storage of the Brandon RV business licence.
# Generate at least 32 random characters. Never expose this as a NEXT_PUBLIC_ variable.
BRANDON_RV_LICENSE_ENCRYPTION_SECRET=
# Optional product version sent to the License Manager (defaults to 1.0.0).
BRANDON_RV_VERSION=1.0.0
